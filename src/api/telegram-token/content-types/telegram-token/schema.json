{
  "kind": "collectionType",
  "collectionName": "telegram_tokens",
  "info": {
    "singularName": "telegram-token",
    "pluralName": "telegram-tokens",
    "displayName": "Telegram token"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "token": {
      "type": "string",
      "unique": true
    },
    "expires_at": {
      "type": "datetime"
    },
    "used": {
      "type": "boolean",
      "default": false
    }
  }
}
