      "target": "plugin::users-permissions.user",
      "inversedBy": "created_projects"
    },
    "time_entries": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::time-entry.time-entry",
      "mappedBy": "project"
    },
    "members": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "projects"
    },
    "color": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::color.color"
    }
  }
